# Oremi Akọrin Environment Configuration
# ============================================================
# Copy this file to .env and modify as needed.
# All settings can also be set as environment variables directly.
# ============================================================

# ── Server Settings ──────────────────────────────────────────────────────────────
# Host address to bind the server to. Use '0.0.0.0' to listen on all interfaces.
SERVER_HOST=localhost

# Port number to bind the server to. Must be between 1 and 65535.
SERVER_PORT=5020

# Root path for the application. Used when running behind a proxy.
API_ROOT_PATH=/

# ── Ollama Settings ──────────────────────────────────────────────────────────────
# URL of the Ollama service. Must include scheme and port.
OLLAMA_BASEURL=http://localhost:31434

# Name of the Ollama model to load and use for NLP processing.
OLLAMA_MODEL=qwen3.5:0.8b

# Whether to automatically pull the model from Ollama registry if not available locally.
OLLAMA_PULL_MODEL=true

# Timeout in seconds for Ollama requests. Must be greater than 1.0.
OLLAMA_REQUEST_TIMEOUT=60.0

# ── Service URLs ──────────────────────────────────────────────────────────────────
# All service URLs are optional - no default values.
# Uncomment and set the URLs for the services you want to use.

# Isinmi - Schedule management, reminders, timers, alarms
ISINMI_URL=http://localhost:37337

# Weather - Climate information, forecasts, conditions, and alerts
WEATHER_URL=http://localhost:31777

# Rediyo - Radio station recommendations
REDIYO_URL=http://localhost:39170

# Kansa - Podcast recommendations
KANSA_URL=http://localhost:34940

# ── MQTT Settings ──────────────────────────────────────────────────────────────────
# MQTT is optional - all settings can be omitted if not using MQTT.
# Uncomment and configure MQTT_BROKER to enable MQTT.

# MQTT broker hostname or IP address. If not set, MQTT is disabled.
MQTT_BROKER=ngaoundere

# MQTT broker port. Must be between 1 and 65535.
MQTT_PORT=51883

# MQTT client identifier. If not set, auto-generated from hostname and process ID.
MQTT_CLIENT_ID=oremi-akorin-1


# MQTT broker username. Optional - only needed if authentication is required.
# MQTT_USERNAME=

# MQTT broker password. Optional - only needed if authentication is required.
# MQTT_PASSWORD=

# Base topic shared with Oremi Device nodes.
OREMI_DEVICE_MQTT_TOPIC=oremi/device

# MQTT keepalive interval in seconds. Must be at least 10.
MQTT_KEEPALIVE=60

# Enable TLS/SSL for MQTT connection.
MQTT_TLS_ENABLED=false

# Path to CA certificate file for MQTT TLS verification.
# MQTT_TLS_CA_CERT=/path/to/ca.crt

# ── Request Settings ──────────────────────────────────────────────────────────────
# Global timeout in seconds for HTTP requests to external services.
REQUEST_TIMEOUT=30.0

# Maximum number of tokens to generate in LLM responses. Must be between 10 and 4096.
MAX_RESPONSE_TOKENS=500

# Temperature for LLM generation - controls randomness (0=deterministic, 1=creative).
LLM_TEMPERATURE=0.1

# ── Search Settings ──────────────────────────────────────────────────────────────
# Enable DuckDuckGo search fallback for unknown queries.
SEARCH_ENABLED=true

# Timeout in seconds for search requests.
SEARCH_TIMEOUT=10.0

# ── Logging Settings ──────────────────────────────────────────────────────────────
# Logging level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=DEBUG

# Path to log file. If not set, logs are written to stderr.
# LOG_FILE=/var/log/oremi-akorin.log
