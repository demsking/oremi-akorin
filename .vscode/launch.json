{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "akorin:app",
        "--reload",
        "--reload-dir",
        "akorin",
        "--host",
        "0.0.0.0",
        "--port",
        "5020"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.example",
      "env": {
        "OREMI_AKORIN_LOG_LEVEL": "DEBUG",
        "OREMI_AKORIN_OLLAMA_BASE_URL": "http://localhost:31434",
        "OREMI_AKORIN_ISAKOSO_URL": "http://localhost:35089/mcp",
        "OREMI_AKORIN_ISINMI_URL": "http://localhost:35073/mcp",
        "OREMI_AKORIN_OJO_URL": "http://localhost:35040/mcp",
        "OREMI_AKORIN_REDIYO_URL": "http://localhost:35076/mcp",
        "OREMI_AKORIN_KANSA_URL": "http://localhost:35046/mcp"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests",
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.example",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
