{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Local",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "oremi_akorin:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "5020"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Container",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "oremi_akorin:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "5020"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    }
  ]
}