# Oremi Akọrin Environment Configuration
# ============================================================
# All settings can also be set as environment variables directly.
# Every application setting uses the OREMI_AKORIN_ prefix.
# ============================================================

# -- Server Settings -------------------------------------------------------------
# Host address to bind the server to. Use 0.0.0.0 to listen on all interfaces.
OREMI_AKORIN_SERVER_HOST=localhost

# Port number to bind the server to. Must be between 1 and 65535.
OREMI_AKORIN_SERVER_PORT=5020

# API prefix/root path for deployments behind a reverse proxy.
OREMI_AKORIN_API_PREFIX=/

# -- LLM Settings ----------------------------------------------------------------
# Fully qualified Pydantic AI model identifier.
# Use ollama:<model-name> for an Ollama-backed model.
OREMI_AKORIN_LLM_MODEL=ollama:qwen3.5:2b

# Ollama base URL. Required only when OREMI_AKORIN_LLM_MODEL starts with ollama:.
# Must be explicitly configured; there is no default.
OREMI_AKORIN_OLLAMA_BASE_URL=http://localhost:11434

# Timeout in seconds for LLM requests.
OREMI_AKORIN_LLM_REQUEST_TIMEOUT=60

# Sampling temperature used by the active LLM backend.
OREMI_AKORIN_LLM_TEMPERATURE=0.1

# Maximum number of tokens to generate in LLM responses.
OREMI_AKORIN_MAX_RESPONSE_TOKENS=500

# Optional custom system prompt. Leave unset to use the built-in Oremi prompt.
# OREMI_AKORIN_LLM_SYSTEM_PROMPT=

# -- Smart Cache Settings --------------------------------------------------------
# Enable the bounded in-memory cache for repeated internal LLM and idempotent component calls.
OREMI_AKORIN_CACHE_ENABLED=true

# Maximum number of cache entries kept in memory. Set to 0 to disable caching.
OREMI_AKORIN_CACHE_MAX_ENTRIES=512

# TTL in seconds for cacheable internal LLM calls.
OREMI_AKORIN_CACHE_LLM_TTL_SECONDS=300.0

# TTL in seconds for idempotent component GET calls.
OREMI_AKORIN_CACHE_COMPONENT_TTL_SECONDS=30.0

# Additional stale window for component GET calls while refreshing in the background.
OREMI_AKORIN_CACHE_COMPONENT_STALE_SECONDS=120.0

# -- Performance Settings --------------------------------------------------------
# Soft end-to-end latency budget in seconds for one user request.
OREMI_AKORIN_REQUEST_BUDGET_SECONDS=20.0

# Maximum time to spend normalizing a user request before continuing with the original text.
OREMI_AKORIN_SPELLCHECK_TIMEOUT_SECONDS=4.0

# Maximum time to spend on LLM routing before using heuristic routing.
OREMI_AKORIN_ROUTE_TIMEOUT_SECONDS=4.0

# Skip LLM spellcheck for short one-token clean commands up to this length. Set to 0 to disable.
OREMI_AKORIN_SKIP_SPELLCHECK_MAX_CHARS=24

# Fail fast for external components after repeated request failures.
OREMI_AKORIN_COMPONENT_CIRCUIT_BREAKER_ENABLED=true

# Consecutive component request failures needed before opening the circuit breaker.
OREMI_AKORIN_COMPONENT_CIRCUIT_BREAKER_FAILURES=3

# Time in seconds an opened component circuit breaker stays open before retry.
OREMI_AKORIN_COMPONENT_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0

# -- Service URLs ----------------------------------------------------------------
# All service URLs are optional base URLs. They must not include a path, query, or fragment.

# Isinmi - Schedule management, reminders, timers, alarms
OREMI_AKORIN_ISINMI_URL=http://localhost:7337

# Weather - Climate information, forecasts, and conditions
OREMI_AKORIN_WEATHER_URL=http://localhost:1777

# Rediyo - Radio station recommendations
OREMI_AKORIN_REDIYO_URL=http://localhost:9170

# Kansa - Podcast recommendations
OREMI_AKORIN_KANSA_URL=http://localhost:4940

# -- MQTT Settings ---------------------------------------------------------------
# MQTT is optional. Set OREMI_AKORIN_MQTT_BROKER to enable MQTT.

# MQTT broker hostname or IP address. If not set, MQTT is disabled.
OREMI_AKORIN_MQTT_BROKER=test.mosquitto.org

# MQTT broker port. Must be between 1 and 65535.
OREMI_AKORIN_MQTT_PORT=1883

# MQTT client identifier. If not set, auto-generated from hostname and process ID.
OREMI_AKORIN_MQTT_CLIENT_ID=oremi-akorin-1

# MQTT broker username/password. Optional.
# OREMI_AKORIN_MQTT_USERNAME=
# OREMI_AKORIN_MQTT_PASSWORD=

# MQTT keepalive interval in seconds. Must be at least 10.
OREMI_AKORIN_MQTT_KEEPALIVE=60

# Enable TLS/SSL for MQTT connection.
OREMI_AKORIN_MQTT_TLS_ENABLED=false

# Path to CA certificate file for MQTT TLS verification.
# OREMI_AKORIN_MQTT_TLS_CA_CERT=/path/to/ca.crt

# -- Request and Search Settings -------------------------------------------------
# Global timeout in seconds for HTTP requests to external services.
OREMI_AKORIN_REQUEST_TIMEOUT=30.0

# Enable DuckDuckGo search fallback for unknown queries.
OREMI_AKORIN_SEARCH_ENABLED=true

# Timeout in seconds for search requests.
OREMI_AKORIN_SEARCH_TIMEOUT=10.0

# -- Logging Settings ------------------------------------------------------------
# Logging level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
OREMI_AKORIN_LOG_LEVEL=INFO

# Path to log file. Leave unset to use the default configured by Settings.
# OREMI_AKORIN_LOG_FILE=/var/log/oremi-akorin.log
